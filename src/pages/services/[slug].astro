---
import ServicePage from '../../components/ServicePage.astro';
import type { ServicePage as ServiceData } from '../../data/services/types';
export function getStaticPaths() {
  const modules = import.meta.glob<{ default: ServiceData }>('../../data/services/*.json', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({ params: { slug: (path.split('/').pop() ?? '').replace('.json', '') }, props: { page: mod.default } }));
}
const { page } = Astro.props;
const { slug } = Astro.params;
---
<ServicePage page={page} slug={slug!} />
