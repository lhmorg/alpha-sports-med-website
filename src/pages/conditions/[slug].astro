---
// Reusable condition page. Each page is driven by src/data/conditions/<slug>.json
// (schema documented in src/data/conditions/README.md) and uses the same visual
// components as the approved Knee Pain page, which keeps its own hand-built file.
import home from '../../data/home.json';
import FeaturedPractitioner from '../../components/FeaturedPractitioner.astro';
import SiteNavigation from '../../components/SiteNavigation.astro';
import PractitionerHero from '../../components/PractitionerHero.astro';
import type { ConditionPage } from '../../data/conditions/types';

export function getStaticPaths() {
  const modules = import.meta.glob<{ default: ConditionPage }>('../../data/conditions/*.json', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = (path.split('/').pop() ?? '').replace('.json', '');
    return { params: { slug }, props: { page: mod.default } };
  });
}

const { page } = Astro.props as { page: ConditionPage };
const { slug } = Astro.params;
// Staged draft icon identifiers are visual scaffolding, mapped to loaded FontAwesome 5 glyphs.
const iconAliases: Record<string, string> = { activity: 'heartbeat', 'file-text': 'file-alt', move: 'arrows-alt', 'message-circle': 'comment', signpost: 'map-signs', footprints: 'shoe-prints', shirt: 'tshirt', 'sliders-horizontal': 'sliders-h' };
const iconClass = (name: string) => { const token = name.replace(/^fa-/, ''); return `fa-${iconAliases[token] || token}`; };
const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const pageUrl = `https://alpha-sports-med-prototype.pages.dev/conditions/${slug}/`;
const trust = page.hero.trust || ['No referral needed', 'Four Melbourne clinics', 'Health fund claiming'];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'MedicalWebPage',name:page.seo.title.split('|')[0].trim(),url:pageUrl,...(page.medicalConditionName === null ? {} : {about:{'@type':'MedicalCondition',name:page.medicalConditionName || page.breadcrumb}})},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://alpha-sports-med-prototype.pages.dev/'},{'@type':'ListItem',position:2,name:'Conditions',item:'https://alpha-sports-med-prototype.pages.dev/conditions/'},{'@type':'ListItem',position:3,name:page.breadcrumb}]},
  {'@type':'FAQPage',mainEntity:page.faqs.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
]};
const allLocations = [
  ['Ascot Vale','246A Union Rd','/assets/images/locations/ascot-vale-storefront.jpg','/locations/ascot-vale/','ascot-vale'],
  ['Newport','109 Blackshaws Rd','/assets/images/locations/newport-storefront.jpg','/locations/newport/','newport'],
  ['Bacchus Marsh','3 Graham St','/assets/images/locations/bacchus-marsh-storefront.jpg','/locations/bacchus-marsh/','bacchus-marsh'],
  ['Hawthorn','1/432 Burwood Rd','/assets/images/locations/hawthorn-clinic.jpg','/locations/hawthorn/','hawthorn']
] ;
const locations = allLocations.filter((loc) => page.clinics === undefined || page.clinics.includes(loc[4] as import('../../data/services/types').ClinicSlug));
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-5" /><link rel="stylesheet" href="/assets/css/condition.css?v=20261006-1" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head><body>
  <header class="site-header"><div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div><div class="site-header__nav-row"><SiteNavigation /></div><SiteNavigation variant="mobile" /></header>
  <main>
    <section class:list={["condition-hero", {"condition-hero--neutral": !!(page.hero.media || page.hero.practitioner) && !page.hero.background}]} style={page.hero.background ? `background-image: linear-gradient(90deg, rgba(23,43,55,.97), rgba(23,43,55,.88) 55%, rgba(23,43,55,.65)), url('${page.hero.background}'); background-position: center center; background-size: cover;` : undefined}><div class="condition-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/conditions/">Conditions</a><span>/</span><span>{page.breadcrumb}</span></nav><p class="eyebrow eyebrow--left">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p class="condition-hero__subhead">{page.hero.subheading}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div>{trust.length > 0 && <div class="condition-trust">{trust.map((item) => <span>{item}</span>)}</div>}</div>{page.hero.practitioner?.cutout ? <PractitionerHero practitioner={page.hero.practitioner} /> : page.hero.practitioner ? <figure class="condition-media"><img src={page.hero.practitioner.image} alt={page.hero.practitioner.imageAlt} fetchpriority="high" /><figcaption><strong>{page.hero.practitioner.name}</strong><span>{page.hero.practitioner.role}</span></figcaption></figure> : page.hero.media ? <figure class="condition-media"><img src={page.hero.media.image} alt={page.hero.media.imageAlt} fetchpriority="high" /><figcaption>{page.hero.media.caption}</figcaption></figure> : <FeaturedPractitioner context="condition" slug={slug} variant="hero" />}</div></section>

    <section class="section condition-urgent"><aside class="urgent-card"><span class="urgent-card__icon"><i class="fas fa-exclamation" aria-hidden="true"></i></span><div><p class="eyebrow eyebrow--left">{page.urgent.eyebrow}</p><h2>{page.urgent.heading}</h2>{(page.urgent.paragraphs || [page.urgent.copy]).map((p) => <p set:html={p} />)}{page.urgent.linkUrl && <a href={page.urgent.linkUrl} target="_blank" rel="noopener noreferrer">{page.urgent.linkLabel} <i class="fas fa-external-link-alt" aria-hidden="true"></i></a>}</div></aside></section>

    {page.pattern && (
      <section class="section"><div class="section-head"><span class="section-head__ghost">{page.pattern.ghost || 'WHERE'}</span><p class="eyebrow">{page.pattern.eyebrow}</p><h2>{page.pattern.heading}</h2>{page.pattern.intro && <p>{page.pattern.intro}</p>}</div><div class="knee-region-grid">{page.pattern.items.map((item, i) => <article><span class="knee-region__number">{String(i + 1).padStart(2, '0')}</span><h3>{item.title}</h3>{item.kicker && <strong>{item.kicker}</strong>}<p set:html={item.copy} />{item.link && <a href={item.link.href}>{item.link.label} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>}</article>)}</div></section>
    )}

    {page.explainer && (
      <section class="section section--alt wear-section"><div class="section-head section-head--left"><span class="section-head__ghost">{page.explainer.ghost || 'WHY'}</span><p class="eyebrow eyebrow--left">{page.explainer.eyebrow}</p><h2>{page.explainer.heading}</h2></div><div class="wear-section__copy">{page.explainer.paragraphs.map((p) => <p set:html={p} />)}{page.explainer.link && <a href={page.explainer.link.href} {...(page.explainer.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="btn btn--outline-navy">{page.explainer.link.label} <i class={`fas ${page.explainer.link.external ? 'fa-external-link-alt' : 'fa-arrow-right'}`} aria-hidden="true"></i></a>}</div></section>
    )}

    {page.focus && (
      <section class="section active-section"><div><p class="eyebrow eyebrow--left">{page.focus.eyebrow}</p><h2>{page.focus.heading}</h2>{page.focus.paragraphs.map((p) => <p set:html={p} />)}{page.focus.link && <a href={page.focus.link.href} class="btn btn--outline-navy">{page.focus.link.label} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>}</div><figure><img src={page.focus.image || '/assets/images/locations/hawthorn-clinic.jpg'} alt={page.focus.imageAlt || 'Alpha Sports Medicine practitioner guiding a patient through movement'} loading="lazy" /><figcaption><i class="fas fa-sliders-h" aria-hidden="true"></i> {page.focus.caption}</figcaption></figure></section>
    )}

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">PLAN</span><p class="eyebrow">{page.process.eyebrow}</p><h2>{page.process.heading}</h2></div><ol class="knee-process">{page.process.steps.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol></section>

    {page.note && (
      <section class="section surgery-section"><div class="surgery-section__icon"><i class={`fas ${iconClass(page.note.icon || 'fa-notes-medical')}`} aria-hidden="true"></i></div><div><p class="eyebrow eyebrow--left">{page.note.eyebrow}</p><h2>{page.note.heading}</h2>{page.note.paragraphs.map((p) => <p set:html={p} />)}</div></section>
    )}

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">TEAM</span><p class="eyebrow">Who you may see</p><h2>{page.servicesHeading || 'Hands-on care and exercise working together'}</h2></div><div class="knee-service-grid">{page.services.map((s) => <a href={s.href}><span><i class={`fas ${iconClass(s.icon)}`} aria-hidden="true"></i></span><div><h3>{s.title}</h3><p>{s.copy}</p></div><i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">MORE</span><p class="eyebrow">Related support</p><h2>Explore connected concerns</h2></div><div class="related-grid">{page.related.map((r) => <a href={r.href}>{r.title}<i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">CLINICS</span><p class="eyebrow">{page.locationsEyebrow}</p><h2>{page.locationsHeading || "See the team close to home"}</h2>{page.locationsCopy && <p>{page.locationsCopy}</p>}</div><div class:list={["location-grid", {"location-grid--single": locations.length === 1, "location-grid--pair": locations.length === 2}]}>{locations.map(([name, address, image, href, key]) => <div class="location-card" style={`background-image:url('${image}')`}><h3>{name}</h3><p class="location-card__address"><i class="fas fa-map-marker-alt"></i> {address}</p><a href={page.clinicLinks?.[key as import("../../data/services/types").ClinicSlug]?.href || href} class="btn btn--primary">{page.clinicLinks?.[key as import("../../data/services/types").ClinicSlug]?.label || "View clinic"}</a></div>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Common questions</p><h2>{page.faqHeading}</h2></div><div class="faq__list">{page.faqs.map(({question, answer}) => <details class="faq__item"><summary><span>{question}</span></summary><div class="faq__answer"><p>{answer}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta closing-cta--knee"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">{page.closing.eyebrow}</p><h2>{page.closing.heading}</h2><p class="closing-cta__copy">{page.closing.copy}</p></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="/locations/hawthorn/">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>

<style>
.condition-hero--neutral { background: linear-gradient(120deg, #172b37, #284857); }
.condition-media { position: relative; width: 100%; max-width: 420px; height: 460px; margin: 0 auto; overflow: hidden; border-radius: 28px; background: #172b37; }
.condition-media img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.condition-media figcaption { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; padding: 50px 20px 24px; color: white; background: linear-gradient(transparent, rgba(23,43,55,.95)); }
.condition-media strong { color: var(--color-primary); font: 700 1.4rem var(--font-heading); }
.location-grid--single { max-width: 560px; margin-inline: auto; grid-template-columns: 1fr; }
@media(max-width:1023px) { .condition-media { height: 400px; } }

.location-grid--pair { max-width: 1000px; margin-inline: auto; }
.wear-section__copy p, .active-section > div > p:not(.eyebrow), .surgery-section > div > p:not(.eyebrow) { color: var(--color-muted); }
.wear-section__copy p + p, .active-section > div > p:not(.eyebrow) + p, .surgery-section > div > p:not(.eyebrow) + p { margin-top: var(--space-5); }
@media(min-width:768px) { .location-grid--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

.wear-section > *, .active-section > *, .surgery-section > * { min-width: 0; }
.wear-section__copy { min-width: 0; }
.wear-section__copy .btn, .active-section .btn { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
</style>
