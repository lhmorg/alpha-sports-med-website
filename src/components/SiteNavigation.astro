---
// Menu authority: Alpha-Sports-Med-Proposed-Sitemap-Opportunity.html,
// selected by Michael on 6 October 2026. Pending page routes remain visible.
import menus from '../data/navigation.json';
interface Props { variant?: 'desktop' | 'mobile'; }
const { variant = 'desktop' } = Astro.props;
---
<nav class={variant === 'mobile' ? 'mobile-nav' : 'site-header__nav'} aria-label={variant === 'mobile' ? 'Mobile' : 'Primary'}>
  <a href="/">Home</a>
  {menus.map(menu => <details class:list={['nav-group', {'nav-group--wide': 'wide' in menu && menu.wide}]}>
    <summary>{menu.title}</summary>
    <div class:list={['nav-group__menu', {'nav-group__menu--wide': 'wide' in menu && menu.wide}]}>
      {menu.groups.map(group => <div class="nav-menu-column">
        {group.title && <h3 class="nav-menu-heading">{group.title}</h3>}
        {group.items.map(item => <a href={item.href}>{item.title}</a>)}
      </div>)}
    </div>
  </details>)}
  <a href="/contact/">Contact Us</a>
</nav>
<style>
  .nav-menu-column { min-width: 0; display: flex; flex-direction: column; }
  .nav-menu-heading { font: inherit; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--color-primary); padding: .6rem .5rem; margin: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('nav[aria-label="Primary"], nav[aria-label="Mobile"]').forEach(nav => {
    const groups = nav.querySelectorAll<HTMLDetailsElement>('details.nav-group');
    groups.forEach(group => group.querySelector('summary')?.addEventListener('click', () => {
      groups.forEach(other => { if (other !== group) other.open = false; });
    }));
    const desktopHover = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
    groups.forEach(group => {
      let closeTimer: ReturnType<typeof setTimeout> | undefined;
      const cancelClose = () => { if (closeTimer !== undefined) clearTimeout(closeTimer); };
      group.addEventListener('pointerenter', event => {
        if (!desktopHover.matches || nav.getAttribute('aria-label') !== 'Primary' || event.pointerType === 'touch') return;
        cancelClose();
        groups.forEach(other => { if (other !== group) other.open = false; });
        group.open = true;
      });
      group.addEventListener('pointerleave', () => {
        if (!desktopHover.matches || nav.getAttribute('aria-label') !== 'Primary') return;
        cancelClose();
        closeTimer = setTimeout(() => {
          if (!group.querySelector('.nav-group__menu')?.contains(document.activeElement)) group.open = false;
        }, 180);
      });
      group.addEventListener('focusout', () => {
        setTimeout(() => { if (!group.contains(document.activeElement)) group.open = false; }, 0);
      });
    });
    nav.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        const open = nav.querySelector<HTMLDetailsElement>('details[open]');
        if (open) { open.open = false; open.querySelector('summary')?.focus(); }
      }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !nav.contains(event.target)) groups.forEach(group => { group.open = false; });
    });
  });
</script>
