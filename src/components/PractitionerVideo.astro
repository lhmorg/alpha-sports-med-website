---
interface Props { videoId: string; name: string; poster: string; }
const { videoId, name, poster } = Astro.props;
const youtubeUrl = `https://www.youtube.com/watch?v=${videoId}`;
---
<div class="practitioner-video" data-introduction data-video-id={videoId} data-video-name={name}>
  <div class="practitioner-video__frame">
    <button type="button" class="practitioner-video__open" aria-label={`Watch introduction from ${name}`}>
      <img src={poster} alt="" loading="lazy" />
      <span class="practitioner-video__label"><span aria-hidden="true">▶</span> Meet {name.replace(/^Dr\s+/, '')}</span>
    </button>
  </div>
  <a class="practitioner-video__fallback" href={youtubeUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube <span class="sr-only">(opens a new tab)</span></a>
</div>
<style>
  .practitioner-video { width: 100%; max-width: 300px; margin-inline: auto; min-width: 0; }
  .practitioner-video__frame { aspect-ratio: 9 / 16; overflow: hidden; border-radius: var(--radius-md); background: var(--color-navy); }
  .practitioner-video__open { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; color: white; cursor: pointer; }
  .practitioner-video__open img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .practitioner-video__label { position: absolute; inset: auto 0 0; padding: 1rem .5rem; background: rgba(23,43,55,.92); font: inherit; font-weight: 700; }
  .practitioner-video__label > span { color: var(--color-primary); margin-right: .4rem; }
  .practitioner-video__open:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -4px; }
  .practitioner-video__frame :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .practitioner-video__fallback { display: inline-block; padding: .6rem 0; font-size: .875rem; color: inherit; text-decoration: underline; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-introduction]').forEach((container) => {
    container.querySelector('button')?.addEventListener('click', () => {
      const frame = container.querySelector('.practitioner-video__frame');
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${container.dataset.videoId}?autoplay=0&playsinline=1&rel=0`;
      iframe.title = `Introduction from ${container.dataset.videoName}`;
      iframe.allow = 'encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.tabIndex = 0;
      frame.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>
