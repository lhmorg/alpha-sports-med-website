---
// Reusable service page. Each page is driven by src/data/services/<slug>.json (schema in
// src/data/services/README.md) and reuses the approved Osteopathy page's components.
// Osteopathy and Shockwave Therapy keep their own hand-built files.
import home from '../data/home.json';
import FeaturedPractitioner from '../components/FeaturedPractitioner.astro';
import PractitionerHero from './PractitionerHero.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import type { ServicePage, ClinicSlug } from '../data/services/types';

const { page, slug, route } = Astro.props as { page: ServicePage; slug: string; route?: string };
// Staged draft icon identifiers are visual scaffolding, mapped to loaded FontAwesome 5 glyphs.
const iconAliases: Record<string, string> = { activity: 'heartbeat', 'file-text': 'file-alt', move: 'arrows-alt', 'message-circle': 'comment', signpost: 'map-signs', footprints: 'shoe-prints', shirt: 'tshirt', 'sliders-horizontal': 'sliders-h' };
const iconClass = (name: string) => { const token = name.replace(/^fa-/, ''); return `fa-${iconAliases[token] || token}`; };
const bookingUrl = home.site.bookingUrl.startsWith('#') ? `/${home.site.bookingUrl}` : home.site.bookingUrl;
const pageUrl = `https://alpha-sports-med-prototype.pages.dev${route || `/services/${slug}/`}`;
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':page.schemaType || 'MedicalWebPage',name:page.seo.title.split('|')[0].trim(),url:pageUrl},
  {'@type':'FAQPage',mainEntity:page.faqs.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}
]};
const allClinics: Record<ClinicSlug, { name: string; address: string; image: string }> = {
  'ascot-vale': { name: 'Ascot Vale', address: '246A Union Rd, Ascot Vale', image: '/assets/images/locations/ascot-vale-storefront.jpg' },
  'newport': { name: 'Newport', address: '109 Blackshaws Rd, Newport', image: '/assets/images/locations/newport-storefront.jpg' },
  'bacchus-marsh': { name: 'Bacchus Marsh', address: '3 Graham St, Bacchus Marsh', image: '/assets/images/locations/bacchus-marsh-storefront.jpg' },
  'hawthorn': { name: 'Hawthorn', address: '1/432 Burwood Rd, Hawthorn', image: '/assets/images/locations/hawthorn-clinic.jpg' }
};
// Inline copy permits only reviewed anchors and strong emphasis; all other markup is escaped.
const inlineCopy = (value: string) => value.split(/(<a href="(?:\/[^"<>]*|tel:[0-9+]+)">|<\/a>|<strong>|<\/strong>)/g).map((part) => /^(<a href="(?:\/[^"<>]*|tel:[0-9+]+)">|<\/a>|<strong>|<\/strong>)$/.test(part) ? part : part.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')).join('');
const teamLinks = page.team.links || [{label: 'Meet the team', href: '/about/team/'}, {label: 'Our qualifications', href: '/about/qualifications/'}];
const clinics = page.clinics.map((key) => ({ key, ...allClinics[key], href: page.clinicLinks?.[key]?.href || `/locations/${key}/`, linkLabel: page.clinicLinks?.[key]?.label || `View ${allClinics[key].name} clinic` }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.seo.title}</title>
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={pageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /><link rel="stylesheet" href="/assets/css/style.css?v=20260827-3" /><link rel="stylesheet" href="/assets/css/service.css?v=20261006-2" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner"><a href="/" class="site-header__logo" aria-label="Alpha Sports Medicine home"><img src="/assets/images/alpha-icon.png" alt="" class="site-header__logo-icon" /><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" class="site-header__logo-full" /></a><div class="site-header__actions"><a class="site-header__phone" href={home.site.phoneHref}><span class="site-header__phone-icon"><i class="fas fa-phone-alt" aria-hidden="true"></i></span><span class="site-header__phone-text"> {home.site.phoneDisplay}</span></a><a href={bookingUrl} class="btn btn--primary">Book online</a><button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button></div></div>
    <div class="site-header__nav-row"><SiteNavigation /></div>
    <SiteNavigation variant="mobile" />
  </header>
  <main>
    <section class:list={["service-hero", {"service-hero--portrait": !!(page.hero.practitioner || page.hero.media) && !page.hero.background}]} style={page.hero.background ? `background-image: linear-gradient(90deg, rgba(23,43,55,.97), rgba(23,43,55,.88) 55%, rgba(23,43,55,.65)), url('${page.hero.background}'); background-position: center center; background-size: cover;` : undefined}><div class="service-hero__inner"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#services">Services</a><span>/</span><span>{page.breadcrumb}</span></nav><p class="eyebrow eyebrow--left">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p class="service-hero__subhead">{page.hero.subheading}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right" aria-hidden="true"></i></a><a href={home.site.phoneHref} class="btn btn--outline"><i class="fas fa-phone-alt" aria-hidden="true"></i> Call {home.site.phoneDisplay}</a></div></div>{page.hero.practitioner ? <PractitionerHero practitioner={page.hero.practitioner} /> : page.hero.media ? <figure class="service-portrait service-portrait--clinic"><img src={page.hero.media.image} alt={page.hero.media.imageAlt} fetchpriority="high" /><figcaption>{page.hero.media.caption}</figcaption></figure> : <FeaturedPractitioner context="service" slug={slug} variant="hero" />}</div></section>

    <section class="section service-intro"><div><div class="section-head section-head--left"><span class="section-head__ghost">MOVE</span><p class="eyebrow eyebrow--left">{page.intro.eyebrow}</p><h2>{page.intro.heading}</h2></div>{page.intro.paragraphs.map((p) => <p set:html={p} />)}</div><figure><img src={page.intro.image || '/assets/images/locations/hawthorn-clinic.jpg'} alt={page.intro.imageAlt || 'Alpha Sports Medicine practitioner providing treatment'} loading="lazy" /><figcaption><i class="fas fa-check-circle"></i> {page.intro.caption}</figcaption></figure></section>

    <section class="section section--alt service-explainer"><div class="section-head section-head--left service-explainer__heading"><span class="section-head__ghost" aria-hidden="true">WHOLE</span><p class="eyebrow eyebrow--left">{page.explainer.eyebrow}</p><h2>{page.explainer.heading}</h2>{page.explainer.concept && <div class="service-explainer__concept"><i class={`fas ${iconClass(page.explainer.concept.icon)}`} aria-hidden="true"></i><span><strong>{page.explainer.concept.title}</strong><small>{page.explainer.concept.copy}</small></span></div>}</div><div>{page.explainer.paragraphs.map((p) => <p set:html={p} />)}</div></section>

    <section class="section section--navy"><div class="section-head"><span class="section-head__ghost">ALPHA</span><p class="eyebrow">{page.benefits.eyebrow || 'How we work'}</p><h2>{page.benefits.heading}</h2><p>{page.benefits.intro}</p></div><div class="service-feature-grid">{page.benefits.items.map((b) => <article><i class={`fas ${iconClass(b.icon)}`}></i><h3>{b.title}</h3><p>{b.copy}</p></article>)}</div></section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">SUPPORT</span><p class="eyebrow">Common reasons to visit</p><h2>{page.conditions.heading}</h2><p>{page.conditions.intro}</p></div><div class="card-grid service-condition-grid">{page.conditions.items.map((c) => <a href={c.href} class="condition-card"><span class="condition-card__icon"><i class={`fas ${iconClass(c.icon)}`} aria-hidden="true"></i></span><span class="condition-card__content"><span class="condition-card__label">{c.title}</span><small>{c.copy}</small></span></a>)}</div></section>

    <section class="section section--alt"><div class="section-head"><span class="section-head__ghost">VISIT</span><p class="eyebrow">What to expect</p><h2>{page.visit.heading}</h2><p>{page.visit.intro}</p></div><ol class="visit-steps">{page.visit.steps.map((step, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol>{page.visit.notes && page.visit.notes.length > 0 && <div class="visit-notes">{page.visit.notes.map((n) => <article><i class={`fas ${iconClass(n.icon)}`} aria-hidden="true"></i><div><h3>{n.title}</h3><p set:html={inlineCopy(n.copy)} /></div></article>)}</div>}</section>

    <section class:list={["section", "service-team", {"service-team--portrait": !!(page.hero.practitioner || page.hero.media)}]}><img src={page.team.image || '/assets/images/team/alpha-team-2026.webp'} alt={page.team.imageAlt || 'The Alpha Sports Medicine team at the Ascot Vale clinic'} loading="lazy" /><div class="service-team__copy"><p class="eyebrow eyebrow--left">{page.team.eyebrow}</p><h2>{page.team.heading}</h2><p class="service-team__description">{page.team.copy}</p><div class="btn-group">{teamLinks.map((link, i) => <a href={link.href} class={`btn ${i === 0 ? "btn--primary" : "btn--outline-navy"}`}>{link.label} <i class="fas fa-arrow-right" aria-hidden="true"></i></a>)}</div></div></section>

    <section id="locations" class="section section--alt">
      <div class="section-head"><span class="section-head__ghost" aria-hidden="true">LOCATIONS</span><p class="eyebrow">Where to see us</p><h2>{page.locationsHeading}</h2>{page.locationsCopy && <p>{page.locationsCopy}</p>}</div>
      <div class:list={["location-grid", {"location-grid--single": clinics.length === 1, "location-grid--pair": clinics.length === 2}]}>
        {clinics.map((c) => <div class="location-card" style={`background-image: url('${c.image}');`}><span class="location-card__pin"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><a href={c.href} class="location-card__link" aria-label={c.linkLabel}><i class="fas fa-external-link-alt" aria-hidden="true"></i></a><h3>{c.name}</h3><p class="location-card__address"><i class="fas fa-map-marker-alt" aria-hidden="true"></i>{c.address}</p><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book</a></div></div>)}
      </div>
      <div class="locations__footer"><p class="locations__phone"><i class="fas fa-phone-alt" aria-hidden="true"></i>One number for all clinics: {home.site.phoneDisplay}</p>{page.showLocationsOverview !== false && <a href="/locations/" class="locations__link">See all the suburbs we serve <i class="fas fa-arrow-right" aria-hidden="true"></i></a>}</div>
    </section>

    <section class="section"><div class="section-head"><span class="section-head__ghost">FAQ</span><p class="eyebrow">Good to know</p><h2>{page.faqHeading}</h2></div><div class="faq__list">{page.faqs.map(({question, answer}) => <details class="faq__item"><summary><span>{question}</span></summary><div class="faq__answer"><p>{answer}</p></div></details>)}</div></section>
    <section class="section section--navy closing-cta closing-cta--osteopathy"><div class="section-head"><span class="section-head__ghost">MOVE</span><p class="eyebrow">{page.closing.eyebrow}</p><h2>{page.closing.heading}</h2><p set:html={inlineCopy(page.closing.copy)} /></div><div class="btn-group"><a href={bookingUrl} class="btn btn--primary">Book an appointment <i class="fas fa-arrow-right"></i></a><a href={home.site.phoneHref} class="btn btn--outline">Call {home.site.phoneDisplay}</a></div></section>
  </main>
  <footer class="site-footer"><div class="site-footer__inner"><div class="site-footer__grid"><div><a href="/" class="site-footer__logo"><img src="/assets/images/alpha-logo-lockup.webp" alt="Alpha Sports Medicine" /></a><p>Multidisciplinary sports medicine clinics across Melbourne. Care built around your goals.</p></div><div><h5>Clinics</h5><ul><li><a href="/locations/ascot-vale/">Ascot Vale</a></li><li><a href="/locations/newport/">Newport</a></li><li><a href="/locations/bacchus-marsh/">Bacchus Marsh</a></li><li><a href="/locations/hawthorn/">Hawthorn</a></li></ul></div><div><h5>About</h5><ul><li><a href="/about/">Our clinic</a></li><li><a href="/about/team/">Meet the team</a></li><li><a href="/about/qualifications/">Qualifications</a></li></ul></div><div><h5>Contact</h5><ul><li><a href={home.site.phoneHref}>{home.site.phoneDisplay}</a></li><li><a href="/contact/">Contact us</a></li><li><a href={bookingUrl}>Book online</a></li></ul></div></div><div class="site-footer__bottom"><p>&copy; 2026 Alpha Sports Medicine.</p></div></div></footer>
  <script is:inline src="/assets/js/main.js"></script>
</body></html>

<style>
.service-hero--portrait { background: linear-gradient(120deg, #172b37, #284857); }
.service-portrait { position: relative; width: 100%; max-width: 420px; height: 460px; margin: 0 auto; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 28px; background: #172b37; }
.service-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.service-portrait figcaption { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; gap: 2px; padding: 50px 20px 24px; background: linear-gradient(transparent, rgba(23,43,55,.95)); }
.service-portrait strong { color: var(--color-primary); font: 700 1.4rem var(--font-heading); }
.service-portrait span { color: white; font-size: .8rem; font-weight: 600; }
@media (max-width: 1023px) { .service-portrait { height: 400px; } }

.location-grid--pair { max-width: 1000px; margin-inline: auto; }
@media(min-width:768px) { .location-grid--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

